      propertyPath: m_Name
      value: Dial - Rat Mayor
      objectReference: {fileID: 0}
    - target: {fileID: 3539757102279911050, guid: 59ddeb0ee22ab534bb4005d34b558143,
        type: 3}
      propertyPath: m_Size.x
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 3539757102279911050, guid: 59ddeb0ee22ab534bb4005d34b558143,
        type: 3}
      propertyPath: m_Size.z
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 7455643174133851167, guid: 59ddeb0ee22ab534bb4005d34b558143,
        type: 3}
      propertyPath: DialogueList.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 7455643174133851167, guid: 59ddeb0ee22ab534bb4005d34b558143,
        type: 3}
      propertyPath: DialogueList.Array.data[0].Text
      value: "You must be the travellers I\u2019ve heard about wandering around town."
      objectReference: {fileID: 0}
    - target: {fileID: 7455643174133851167, guid: 59ddeb0ee22ab534bb4005d34b558143,
        type: 3}
      propertyPath: DialogueList.Array.data[1].Text
      value: "We\u2019ve been here for less than a minute, how have you already heard
        about us?"
      objectReference: {fileID: 0}
    - target: {fileID: 7455643174133851167, guid: 59ddeb0ee22ab534bb4005d34b558143,
        type: 3}
      propertyPath: DialogueList.Array.data[2].Text
      value: "Would you be kind enough to take on a quest for us? Recently we\u2019ve
        been suffering from a food shortage, as our cheese storage was mysteriously
        emptied overnight."
      objectReference: {fileID: 0}
    - target: {fileID: 7455643174133851167, guid: 59ddeb0ee22ab534bb4005d34b558143,
        type: 3}
      propertyPath: DialogueList.Array.data[3].Text
      value: If you could find our cheese and identify the thief, we would be eternally
        grateful!
      objectReference: {fileID: 0}
    - target: {fileID: 7455643174133851167, guid: 59ddeb0ee22ab534bb4005d34b558143,
        type: 3}
      propertyPath: DialogueList.Array.data[4].Text
      value: Of course we will help you, meow! How mean of them to steal your cheese!
      objectReference: {fileID: 0}
    - target: {fileID: 7455643174133851167, guid: 59ddeb0ee22ab534bb4005d34b558143,
        type: 3}
      propertyPath: DialogueList.Array.data[5].Text
      value: Do we get a reward?
      objectReference: {fileID: 0}
    - target: {fileID: 7455643174133851167, guid: 59ddeb0ee22ab534bb4005d34b558143,
        type: 3}
      propertyPath: DialogueList.Array.data[6].Text
      value: Ah, yes! We will pay you handsomely, of course.
      objectReference: {fileID: 0}
    - target: {fileID: 7455643174133851167, guid: 59ddeb0ee22ab534bb4005d34b558143,
        type: 3}
      propertyPath: DialogueList.Array.data[7].Text
      value: Please! Find out who is behind this!
      objectReference: {fileID: 0}
    - target: {fileID: 7455643174133851167, guid: 59ddeb0ee22ab534bb4005d34b558143,
        type: 3}
      propertyPath: DialogueList.Array.data[0].Character
      value: 
      objectReference: {fileID: 11400000, guid: e549c00086e74e84ea7ff7786ee83136,
        type: 2}
