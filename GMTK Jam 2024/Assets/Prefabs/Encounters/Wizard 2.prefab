  m_Script: {fileID: 11500000, guid: 3f40fd78745c53b4080855d6d7c305ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  DialogueList:
  - Text: Past the village you run into a familiar face.
    Character: {fileID: 11400000, guid: 1ec585e29aabd264aa70d92c405bd350, type: 2}
    UseCustomPositioning: 0
    CustomPosition: {x: 0, y: 0, z: 0}
    CustomScale: {x: 0, y: 0, z: 0}
    AutomaticContinueOnly: 0
    Actions:
      m_PersistentCalls:
        m_Calls: []
  - Text: Tis I, Billius Ronaldorico Bleatario. I have come to challenge you all,
      but I am far stronger than last you saw me!
    Character: {fileID: 11400000, guid: 951e0b6242b07e746a6494341f74afc9, type: 2}
    UseCustomPositioning: 0
    CustomPosition: {x: 0, y: 0, z: 0}
    CustomScale: {x: 0, y: 0, z: 0}
    AutomaticContinueOnly: 0
    Actions:
      m_PersistentCalls:
        m_Calls: []
  - Text: Now that you mention it, this guy stinks a lot like cheese, meow! Perhaps
      he is the thief!
    Character: {fileID: 11400000, guid: 42983cc6bc6894058b76e65e2d009577, type: 2}
    UseCustomPositioning: 0
    CustomPosition: {x: 0, y: 0, z: 0}
    CustomScale: {x: 0, y: 0, z: 0}
    AutomaticContinueOnly: 0
    Actions:
      m_PersistentCalls:
        m_Calls: []
  - Text: A simple cheese thief, I? I think not! Avast, and face me at my worst puny
      mortals!
    Character: {fileID: 11400000, guid: 951e0b6242b07e746a6494341f74afc9, type: 2}
    UseCustomPositioning: 0
    CustomPosition: {x: 0, y: 0, z: 0}
    CustomScale: {x: 0, y: 0, z: 0}
    AutomaticContinueOnly: 0
    Actions:
      m_PersistentCalls:
        m_Calls: []
  _currentDialogueIndex: 0
