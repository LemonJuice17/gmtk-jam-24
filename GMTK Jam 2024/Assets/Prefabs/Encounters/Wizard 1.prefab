--- !u!114 &7836688884884805775
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4058078619914341080}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3f40fd78745c53b4080855d6d7c305ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  DialogueList:
  - Text: "How could this be!?? I, Billius Ronaldorico Bleatario, defeated by simple
      plebians. \r\nI will be back! And you will rue the day you crossed paths with
      mehhhehh."
    Character: {fileID: 0}
    UseCustomPositioning: 0
    CustomPosition: {x: 0, y: 0, z: 0}
    CustomScale: {x: 0, y: 0, z: 0}
    AutomaticContinueOnly: 0
    Actions:
      m_PersistentCalls:
        m_Calls: []
  - Text: "Let\u2019s just kill him and he won\u2019t be able to come after us."
    Character: {fileID: 0}
    UseCustomPositioning: 0
    CustomPosition: {x: 0, y: 0, z: 0}
    CustomScale: {x: 0, y: 0, z: 0}
    AutomaticContinueOnly: 0
    Actions:
      m_PersistentCalls:
        m_Calls: []
  - Text: "Nah leave him. He\u2019s running off anyway."
    Character: {fileID: 0}
    UseCustomPositioning: 0
    CustomPosition: {x: 0, y: 0, z: 0}
    CustomScale: {x: 0, y: 0, z: 0}
    AutomaticContinueOnly: 0
    Actions:
      m_PersistentCalls:
        m_Calls: []
  _currentDialogueIndex: 0
  AfterDialogue:
    m_PersistentCalls:
      m_Calls: []
