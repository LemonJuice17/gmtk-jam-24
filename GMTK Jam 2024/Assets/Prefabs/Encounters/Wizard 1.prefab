  m_Name: 
  m_EditorClassIdentifier: 
  DialogueList:
  - Text: Okay, so, if I have this right... Okay, here's your first guy. <shake>Ahem</shake>.
    Character: {fileID: 11400000, guid: 1ec585e29aabd264aa70d92c405bd350, type: 2}
    UseCustomPositioning: 0
    CustomPosition: {x: 0, y: 0, z: 0}
    CustomScale: {x: 0, y: 0, z: 0}
    AutomaticContinueOnly: 0
    Actions:
      m_PersistentCalls:
        m_Calls: []
  - Text: "Ah hah. Enemies! You will not defeat the magnifcentiecious Billius Ronaldorico
      Bleatario.\r\nI will engage you in combat, and defeat you all spectacularly!\r"
    Character: {fileID: 11400000, guid: 951e0b6242b07e746a6494341f74afc9, type: 2}
    UseCustomPositioning: 0
    CustomPosition: {x: 0, y: 0, z: 0}
    CustomScale: {x: 0, y: 0, z: 0}
