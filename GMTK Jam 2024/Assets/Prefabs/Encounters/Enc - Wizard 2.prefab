PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.size
      value: 12
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.data[0].Text
      value: How <act>cough</act> could this be..?
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.data[1].Text
      value: I am the most powerful of the goat arcane masters...
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.data[2].Text
      value: I have <act>cough</act> mastered even the hardest spells in the novice
        tier one spell book...
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.data[3].Text
      value: "Ha, only tier one? You\u2019re so weak! What a loser!"
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.data[4].Text
      value: "Gillbert, you haven\u2019t used a single healing spell all game, you
        can\u2019t talk."
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.data[5].Text
      value: And your attacks are so weak meow!
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.data[6].Text
      value: "Don\u2019t ignore me! Mortals! You think you have won... Against Billius
        Ronaldorico Bleatario... "
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.data[7].Text
      value: BUT! I will return shortly... Cape swish.
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.data[8].Text
      value: He leaves so stylishly meow!
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.data[9].Text
      value: Why did he just say 'cape swish' out loud?
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.data[10].Text
      value: As the wizard leaves, defeated, he drops a scroll.
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
      propertyPath: DialogueList.Array.data[11].Text
      value: You have now learned the ability "Blast"
      objectReference: {fileID: 0}
    - target: {fileID: 1220581904049086502, guid: e61d923b2ace4264e9b1d7f3fac82905,
        type: 3}
