  DialogueList:
  - Text: "Hey guys, so for today\u2019s game session I have something different.\r"
    character: {fileID: 11400000, guid: d7f994b78bf4f4c3ba2c0fb6f8ed3219, type: 2}
    UseCustomPositioning: 0
