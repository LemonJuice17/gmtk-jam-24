    CustomScale: {x: 0, y: 0, z: 0}
    AutomaticContinueOnly: 0
    Actions:
      m_PersistentCalls:
        m_Calls: []
  - Text: "This board game I bought will let you turn into your figures. It\u2019s
      the most immersive tabletop in stores at the moment."
    character: {fileID: 11400000, guid: d7f994b78bf4f4c3ba2c0fb6f8ed3219, type: 2}
    UseCustomPositioning: 0
    CustomPosition: {x: 0, y: 0, z: 0}
    CustomScale: {x: 0, y: 0, z: 0}
    AutomaticContinueOnly: 0
    Actions:
      m_PersistentCalls:
        m_Calls: []
  - Text: I'll finish setting up and we can start.
