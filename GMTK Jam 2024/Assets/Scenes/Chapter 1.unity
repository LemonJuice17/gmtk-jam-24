    - target: {fileID: 14887910860056475, guid: db17cdc78f2f645488cc58d6bb9e1c3d,
        type: 3}
      propertyPath: DialogueList.Array.data[5].Character
      value: 
      objectReference: {fileID: 11400000, guid: 7be59198af45640309ec9b9f3cd3dd21,
        type: 2}
    - target: {fileID: 14887910860056475, guid: db17cdc78f2f645488cc58d6bb9e1c3d,
        type: 3}
      propertyPath: AfterDialogue.m_PersistentCalls.m_Calls.Array.size
      value: 0
